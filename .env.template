# launchdock 環境變數範本
# 複製此檔案為 .env 並填入實際值（.env 已加入 .gitignore）

# ========== AI Provider API Keys ==========
# 用於 auto-capture match 功能和其他 AI 整合
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=xxx
OPENAI_API_KEY=sk-xxx

# ========== Supabase ==========
# 用於文章互動功能（問答、回饋等）
PUBLIC_SUPABASE_URL=https://xxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=xxx

# ========== Supabase Edge Function 密鑰 ==========
# 以下變數透過 supabase secrets set 設定，不需放在 .env 中
# 但記錄在此供參考
# RESEND_API_KEY=re_xxx       ← Email 發送（Resend API）
# FROM_EMAIL=hello@launchdock.app  ← 寄件者地址

# ========== 藍鴨週報（公開訂閱）==========
# 本機預覽表單不需要以下密鑰。上線步驟見 docs/newsletter-subscribe.md。
# 未得 Joseph 授權前：不要套用 migration、不要部署 Edge Function、不要改 DNS。
#
# Edge Function secrets（supabase secrets set，不要放進 .env 或前端）：
#   RESEND_API_KEY=re_xxx          ← 確認信走既有 Resend；網域尚未驗證前寄不出 @launchdock.app
#   FROM_EMAIL=藍鴨週報 <noreply@launchdock.app>
#   PUBLIC_SITE_URL=https://launchdock.app
#   TURNSTILE_SECRET=              ← 可選；設了之後訂閱必須通過 Turnstile
#   TURNSTILE_HOSTNAMES=launchdock.app,www.launchdock.app
#
# Cloudflare Pages / 本機前端（可放 .env，切勿把 secret 放到 PUBLIC_ 變數）：
# PUBLIC_TURNSTILE_SITE_KEY=      ← 可選；與 TURNSTILE_SECRET 成對，未設則只靠 honeypot

# ========== 路徑設定 ==========
# auto-capture CLI 位置
AUTO_CAPTURE_PATH=~/Documents/github/auto-capture

# 截圖暫存目錄
CAPTURES_BASE=~/Desktop/captures

# 公開圖片目錄（相對路徑）
PUBLIC_IMAGES_DIR=./public/images/articles
