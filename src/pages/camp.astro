---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CAMP_HOOK_TITLE_ZH } from '../data/camp';

const weeks = [
  {
    title: 'Week 0',
    body: '先分析自己過去的 AI 對話，找出使用模式，寫出屬於自己的 system prompt。',
  },
  {
    title: 'Week 1',
    body: '讓 AI 用唯讀方式讀 Gmail、日曆、雲端硬碟，把待回信、行程衝突、檔案數字整理成一份一週簡報。',
  },
  {
    title: 'Week 2',
    body: '接上 Notion，建立自己的「我的 100 天」任務板，請 AI 寫週回顧、幫忙排優先順序。',
  },
];
---

<BaseLayout
  title="藍鴨陪跑營"
  description="藍鴨陪跑營將於 2027 年 1 月開跑。以錄影課程與陪跑營混合進行，先看示範錄影，再一起實作。"
>
  <section class="camp-hero" aria-labelledby="camp-page-title">
    <div class="camp-wrap">
      <p class="camp-eyebrow">藍鴨陪跑營</p>
      <h1 id="camp-page-title" class="camp-title">{CAMP_HOOK_TITLE_ZH}</h1>
      <p class="camp-lead">
        以 Google（Gmail、日曆、雲端硬碟）和 Notion 為核心；ChatGPT、Claude、Gemini、Grok 都有教學。
      </p>
    </div>
  </section>

  <div class="camp-wrap camp-body">
    <section aria-labelledby="camp-format-title">
      <h2 id="camp-format-title">上課方式</h2>
      <p>
        採用錄影課程與陪跑營混合的方式進行。每單元先看示範錄影，再在陪跑營裡用練習資料實作；每題都有檢核標準和參考答案。單元依進度逐週開放。
      </p>
    </section>

    <section aria-labelledby="camp-courses-title">
      <h2 id="camp-courses-title">有哪些課程</h2>
      <p>
        目前先公開已確認的前三週。之後的週次還在規劃中，確定後會再補到這一頁。
      </p>
      <ol class="camp-weeks">
        {weeks.map((week) => (
          <li>
            <h3>{week.title}</h3>
            <p>{week.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="camp-takeaway-title">
      <h2 id="camp-takeaway-title">學員會拿到</h2>
      <p>
        自己的 system prompt、接好 Google 和 Notion 的 AI 助理、「我的 100 天」任務板，以及每週可以照做的任務卡和題目。
      </p>
    </section>

    <section class="camp-survey" aria-labelledby="camp-survey-title">
      <h2 id="camp-survey-title">填問卷，拿優惠碼</h2>
      <p>
        填寫問卷後可以拿到優惠碼。問卷連結、優惠碼內容，以及填完後怎麼拿到碼，都還在準備，確定後會放在這裡。
      </p>
      <button type="button" class="camp-survey-btn" disabled>
        問卷連結準備中
      </button>
    </section>
  </div>
</BaseLayout>

<style>
  .camp-hero {
    background: linear-gradient(135deg, #0f3460 0%, #1a4a8a 100%);
    color: #ffffff;
    padding: 36px 0 32px;
  }

  .camp-wrap {
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .camp-eyebrow {
    display: inline-block;
    margin: 0 0 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .camp-title {
    margin: 0 0 12px;
    font-size: 1.85rem;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    overflow-wrap: break-word;
  }

  .camp-lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #ffffff;
    overflow-wrap: break-word;
  }

  .camp-body {
    padding-top: 36px;
    padding-bottom: 56px;
  }

  .camp-body section + section {
    margin-top: 32px;
  }

  .camp-body h2 {
    margin: 0 0 12px;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .camp-body p {
    margin: 0 0 12px;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    overflow-wrap: break-word;
  }

  .camp-body p:last-child {
    margin-bottom: 0;
  }

  .camp-weeks {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .camp-weeks li {
    margin: 0;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--color-surface-light);
    border: 1px solid var(--color-surface-lighter);
  }

  .camp-weeks h3 {
    margin: 0 0 6px;
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f3460;
  }

  :global(html[data-theme='dark']) .camp-weeks h3 {
    color: #ffffff;
  }

  .camp-weeks p {
    margin: 0;
  }

  .camp-survey {
    padding: 24px 20px;
    border-radius: 16px;
    background: linear-gradient(135deg, #0f3460 0%, #1a4a8a 100%);
    color: #ffffff;
  }

  .camp-survey h2,
  .camp-survey p {
    color: #ffffff;
  }

  .camp-survey-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 8px;
    padding: 10px 20px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: not-allowed;
    opacity: 0.7;
  }

  @media (max-width: 720px) {
    .camp-hero {
      padding: 24px 0 22px;
    }

    .camp-wrap {
      padding: 0 20px;
    }

    .camp-title {
      font-size: 1.45rem;
    }

    .camp-lead {
      font-size: 0.95rem;
    }

    .camp-body {
      padding-top: 28px;
      padding-bottom: 40px;
    }

    .camp-survey-btn {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
