---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  kuaibaoShow,
  latestKuaibaoEpisode,
  kuaibaoYoutubeWatchUrl,
  kuaibaoPodcastEpisodeUrl,
  formatKuaibaoDate,
} from '../../data/kuaibao';

// TODO: Apple Podcasts is not submitted yet; add the link once it is live (no URL for now).
const links = [
  { label: 'YouTube playlist', note: 'every episode in one place', href: kuaibaoShow.youtubePlaylist },
  { label: 'Spotify', note: 'listen as a podcast', href: kuaibaoShow.spotify },
  { label: 'Podcast RSS', note: 'paste into your favorite podcast app', href: kuaibaoShow.rss },
  { label: 'YouTube channel (跟著Joseph學AI)', note: 'more hands-on AI videos', href: kuaibaoShow.youtubeChannel },
];

const latestDate = formatKuaibaoDate(latestKuaibaoEpisode.date, 'en');
const youtubeUrl = kuaibaoYoutubeWatchUrl();
const podcastUrl = kuaibaoPodcastEpisodeUrl();
---

<BaseLayout
  title="藍鴨快報 (Blue Duck Briefing)"
  lang="en"
  description="Blue Duck Briefing — the latest AI news from X in about 3 minutes a day, hosted by Joseph with co-host Xiaowei. Episodes are in Mandarin Chinese."
>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">Blue Duck Briefing</h1>
    <p class="text-text-secondary mb-6">藍鴨快報 — the latest AI news from X</p>

    <div class="prose">
      <h2>What is it?</h2>
      <p>
        AI news moves fast, and much of it shows up on X first.
        We boil it down into a roughly 3-minute daily briefing, hosted by Joseph with Xiaowei as co-host,
        so you can catch up over a coffee or on your commute. Episodes are in Mandarin Chinese.
      </p>

      <h2>Watch or listen</h2>
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
            <span> — {l.note}</span>
          </li>
        ))}
      </ul>

      <h2>Latest episode</h2>
      <p>{latestDate}</p>
      <ul>
        <li><a href={youtubeUrl} target="_blank" rel="noopener noreferrer">Watch on YouTube</a></li>
        <li><a href={podcastUrl} target="_blank" rel="noopener noreferrer">Podcast episode page</a></li>
      </ul>

      <h2>Contact</h2>
      <p>
        Feedback or topics you'd like us to cover? Write to
        <a href={`mailto:${kuaibaoShow.contactEmail}`}>{kuaibaoShow.contactEmail}</a>.
      </p>
    </div>
  </div>
</BaseLayout>
