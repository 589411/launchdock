---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeminiCampRegisterForm from './GeminiCampRegisterForm.tsx';
import type { Locale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = 'zh-tw' } = Astro.props;
const isEn = lang === 'en';

const copy = isEn
  ? {
      docTitle: 'Pre-register · Blue Duck Gemini Coaching Camp',
      description: 'Pre-register for the Blue Duck Gemini Coaching Camp. Enter a discount code to see your price.',
      eyebrow: 'Pre-registration',
      title: 'Pre-register for the Gemini Coaching Camp',
      lead: 'Pre-registration is open. Leave your details and we will get in touch by email.',
      back: '← Back to course info',
      note: 'After you submit, we will confirm the start date and payment method by email.',
    }
  : {
      docTitle: '預先報名 · 藍鴨Gemini陪跑營',
      description: '預先報名藍鴨Gemini陪跑營。填寫優惠碼即可看到折扣後的價格。',
      eyebrow: '預先報名',
      title: '預先報名藍鴨Gemini陪跑營',
      lead: '目前開放預先報名，留下資料後我們會以 Email 與你聯繫。',
      back: '← 回到課程資訊',
      note: '送出後，我們會以 Email 與你確認開課時間與繳費方式。',
    };

const backHref = isEn ? '/en/gemini-camp/' : '/gemini-camp/';
---

<BaseLayout title={copy.docTitle} description={copy.description} lang={lang}>
  <section class="gcr-hero">
    <div class="gcr-wrap">
      <p class="gcr-eyebrow">{copy.eyebrow}</p>
      <h1 class="gcr-title">{copy.title}</h1>
      <p class="gcr-lead">{copy.lead}</p>
      <p class="gcr-back"><a href={backHref}>{copy.back}</a></p>
    </div>
  </section>

  <div class="gcr-wrap gcr-body">
    <GeminiCampRegisterForm client:load lang={lang} />
    <p class="gcr-note">{copy.note}</p>
  </div>
</BaseLayout>

<style>
  .gcr-hero {
    background: linear-gradient(135deg, #0f3460 0%, #1a4a8a 100%);
    color: #ffffff;
    padding: 36px 0 32px;
  }

  .gcr-wrap {
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .gcr-eyebrow {
    display: inline-block;
    margin: 0 0 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.4);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .gcr-title {
    margin: 0 0 12px;
    font-size: 1.7rem;
    line-height: 1.3;
    font-weight: 800;
    color: #ffffff;
  }

  .gcr-lead,
  .gcr-back {
    margin: 0 0 8px;
    font-size: 1rem;
    line-height: 1.7;
    color: #ffffff;
  }

  .gcr-back a {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .gcr-body {
    padding-top: 32px;
    padding-bottom: 56px;
  }

  .gcr-note {
    margin-top: 16px;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  :global(.gcr-form) {
    display: grid;
    gap: 20px;
  }

  :global(.gcr-field) {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  :global(.gcr-field > label),
  :global(.gcr-field > legend) {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    padding: 0;
  }

  :global(.gcr-form input[type='text']),
  :global(.gcr-form input:not([type])),
  :global(.gcr-form input[type='email']) {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--color-surface-lighter);
    background: var(--color-surface-light);
    color: var(--color-text-primary);
    font-size: 1rem;
    box-sizing: border-box;
  }

  :global(.gcr-options) {
    display: grid;
    gap: 8px;
  }

  :global(.gcr-option),
  :global(.gcr-consent) {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  :global(.gcr-option input),
  :global(.gcr-consent input) {
    margin-top: 5px;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  :global(.gcr-hint) {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  :global(.gcr-coupon-row) {
    display: flex;
    gap: 8px;
  }

  :global(.gcr-coupon-row input) {
    flex: 1;
    min-width: 0;
  }

  :global(.gcr-btn-secondary),
  :global(.gcr-btn-primary) {
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
  }

  :global(.gcr-btn-secondary) {
    border: 1px solid #0f3460;
    background: transparent;
    color: #0f3460;
  }

  :global(.gcr-btn-secondary:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  :global(.gcr-btn-primary) {
    border: 0;
    background: #0f3460;
    color: #ffffff;
  }

  :global(.gcr-btn-primary:disabled) {
    opacity: 0.6;
    cursor: wait;
  }

  :global(html[data-theme='dark'] .gcr-btn-secondary) {
    color: #ffffff;
    border-color: #ffffff;
  }

  :global(.gcr-total) {
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--color-surface-light);
    border: 1px solid var(--color-surface-lighter);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  :global(.gcr-ok) {
    margin: 0;
    font-size: 0.9rem;
    color: #15803d;
  }

  :global(.gcr-error) {
    margin: 0;
    font-size: 0.9rem;
    color: #b91c1c;
  }

  :global(.gcr-hp) {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  :global(.gcr-success) {
    padding: 24px 20px;
    border-radius: 14px;
    background: var(--color-surface-light);
    border: 1px solid var(--color-surface-lighter);
  }

  :global(.gcr-success h2) {
    margin: 0 0 8px;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  :global(.gcr-success p) {
    margin: 0;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  @media (max-width: 720px) {
    .gcr-wrap {
      padding: 0 20px;
    }

    .gcr-title {
      font-size: 1.4rem;
    }
  }
</style>
